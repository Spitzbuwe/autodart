<Window x:Class="AutodartsTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutodartsTrainer.ViewModels"
        mc:Ignorable="d"
        Title="AutodartsTrainer"
        WindowStartupLocation="CenterScreen"
        MinWidth="1200"
        MinHeight="800"
        KeyDown="Window_OnKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ConfirmTurnCommand}" />
        <KeyBinding Key="N" Command="{Binding NextPlayerCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="12" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[Players]}" VerticalAlignment="Center" FontWeight="Bold" />
                <ComboBox Width="220"
                          ItemsSource="{Binding GameModes}"
                          SelectedItem="{Binding SelectedGameMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NameResourceKey, Converter={StaticResource LocalizationKeyConverter}}"
                                       ToolTip="{Binding DescriptionResourceKey, Converter={StaticResource LocalizationKeyConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Width="160"
                         Text="{Binding NewPlayerName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="{Binding Source={StaticResource Localization}, Path=[AddPlayer]}"
                        Command="{Binding AddPlayerCommand}" />
                <Separator Width="1" Margin="12,0" />
                <Button Content="{Binding Source={StaticResource Localization}, Path=[ToggleTheme]}"
                        Command="{Binding ToggleThemeCommand}" />
                <Button Content="{Binding Source={StaticResource Localization}, Path=[ToggleLanguage]}"
                        Command="{Binding ToggleLanguageCommand}" />
                <ToggleButton Content="{Binding Source={StaticResource Localization}, Path=[Audio]}"
                              IsChecked="{Binding AudioEnabled, Mode=TwoWay}" />
                <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[CameraStatus]}" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding ConnectedCameras}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BadgeBackgroundBrush}" Padding="4,2" CornerRadius="4">
                                <TextBlock Text="{Binding}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CameraStatusText}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3"
                       Text="{Binding CurrentModeDescription}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,12" />

            <DataGrid Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding Players}"
                      SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      Margin="0,0,12,0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ActiveRowBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ActiveRowBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[PlayerHeader]}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[ScoreHeader]}" Binding="{Binding RemainingScore}" Width="80" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[LastThrowsHeader]}" Binding="{Binding LastThree}" Width="140" />
                    <DataGridTextColumn Header="Ø" Binding="{Binding Statistics.OverallAverage}" Width="70" />
                    <DataGridTextColumn Header="9" Binding="{Binding Statistics.FirstNineAverage}" Width="70" />
                    <DataGridTextColumn Header="CO %" Binding="{Binding Statistics.CheckoutPercentage}" Width="80" />
                    <DataGridTextColumn Header="D %" Binding="{Binding Statistics.DoublePercentage}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="12" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TurnProgress]}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TurnProgress}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,12">
                        <TextBox x:Name="ManualInputBox" Width="120" FontSize="16"
                                 Text="{Binding ManualScoreInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{Binding Source={StaticResource Localization}, Path=[AddDart]}"
                                Command="{Binding AddManualScoreCommand}" />
                        <Button Content="{Binding Source={StaticResource Localization}, Path=[ClearTurn]}"
                                Command="{Binding ClearTurnCommand}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SegmentButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="80" ItemHeight="36" MinWidth="400" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Margin="4"
                                            Command="{Binding DataContext.AddSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Right">
                        <Button Content="{Binding Source={StaticResource Localization}, Path=[Undo]}"
                                Command="{Binding UndoCommand}" />
                        <Button Content="{Binding Source={StaticResource Localization}, Path=[NextPlayer]}"
                                Command="{Binding NextPlayerCommand}" />
                        <Button Content="{Binding Source={StaticResource Localization}, Path=[ConfirmTurn]}"
                                Command="{Binding ConfirmTurnCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="12">
                <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="12" CornerRadius="6">
                    <ContentControl Content="{Binding SelectedPlayer}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[ScoreHeader]}" FontSize="16" />
                                        <TextBlock Text="{Binding RemainingScore}" FontSize="16" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[LadderTarget]}" />
                                        <TextBox Width="60" Text="{Binding LadderTarget, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TargetFocus]}" />
                                        <ComboBox Width="80" ItemsSource="{Binding DataContext.TargetFocusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding TargetFocusNumber}" />
                                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[TargetFocusRemainingLabel]}" />
                                        <TextBlock Text="{Binding TargetFocusRemaining}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[DoubleRoutine]}" />
                                        <ComboBox Width="80" ItemsSource="{Binding DataContext.DoubleRoutineOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DoubleRoutineTarget}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Ø" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Statistics.OverallAverage}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Statistics.FirstNineAverage}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="CO %" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Statistics.CheckoutPercentage}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="D %" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Statistics.DoublePercentage}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="12" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[RecentDarts]}" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding RecentDarts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Dart.DisplayText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="12" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={StaticResource Localization}, Path=[SessionHistory]}" FontWeight="Bold" />
                        <ListBox ItemsSource="{Binding SessionHistory}" Height="200" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding Source={StaticResource Localization}, Path=[ExportJson]}"
                            Command="{Binding ExportJsonCommand}" />
                    <Button Content="{Binding Source={StaticResource Localization}, Path=[ExportCsv]}"
                            Command="{Binding ExportCsvCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
